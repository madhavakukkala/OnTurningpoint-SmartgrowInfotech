# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is gitignored — never commit real keys or URLs.
# On Vercel/Netlify, add the same variables in the project's dashboard.

# ---------------------------------------------------------------------------
# Production domain
# ---------------------------------------------------------------------------
# Drives canonical URLs, Open Graph tags, sitemap.xml and the footer QR code.
# After changing this, re-run `npm run qr` so the QR points at the right domain.
NEXT_PUBLIC_SITE_URL=https://onturningpoint.com

# ---------------------------------------------------------------------------
# Contact form → Google Sheets
# ---------------------------------------------------------------------------
# Full setup instructions are in scripts/google-apps-script.gs.
#
# The Apps Script web app URL, ending in /exec:
GOOGLE_SHEETS_WEBHOOK_URL=

# Must match SHARED_SECRET inside the Apps Script. Generate one with:
#   node -e "console.log(crypto.randomUUID())"
GOOGLE_SHEETS_SHARED_SECRET=

# NOTE: while these two are empty, the contact form returns an error to the
# visitor rather than pretending to succeed. That is deliberate — an enquiry
# that silently goes nowhere is worse than one that visibly fails, because the
# student believes someone is going to call them back.
